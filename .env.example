# Copy this file to .env and fill it in. Never commit .env.

# Settings → Developer → your bot → Token (starts with yb_)
YAPPER_BOT_TOKEN=

# Optional: where the bot keeps its settings (welcomers, triggers, buttons, reaction roles).
# YAPHOOK_DATA_FILE=./data/yaphook.json

# Optional: the YapHook site share links point at.
# YAPHOOK_SITE=https://yaphook.dev
